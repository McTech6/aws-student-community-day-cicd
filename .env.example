# Copy this file to apps/api/.env
# Never commit .env — only this example file.

# Local Postgres from compose.yaml (docker compose up -d). Not a secret.
# In AWS the API gets its database settings from Secrets Manager instead.
DATABASE_URL="postgresql://forge:forge@localhost:5432/forge"

# Optional. Comma-separated browser origins allowed to call the API directly.
# CORS_ORIGINS="http://localhost:3000"

# Optional. Port the API listens on.
# PORT=3001
