# Copy this file to apps/api/.env
# Never commit .env — only this example file.

# Neon pooled connection string (host contains "-pooler"). Used by the running API.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/forge?sslmode=require"

# Same Neon database, direct host (no "-pooler"). Used by prisma migrate.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/forge?sslmode=require"
