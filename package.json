{
  "name": "forge",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @forge/web",
    "dev:api": "npm run dev -w @forge/api",
    "build:web": "npm run build -w @forge/web",
    "build:api": "npm run build -w @forge/api",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "audit:high": "npm audit --audit-level=high",
    "build": "npm run build --workspaces --if-present",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run audit:high && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "multer": "2.5.0",
    "deepmerge-ts": "^8.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.1"
  }
}
